# ---- App (bundled into the client; only map *rendering* keys belong here) ----
# Google Maps SDK keys, restricted to your Android package / iOS bundle / HTTP referrer.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Google Maps "Map ID" used by the web map for Advanced Markers (DEMO_MAP_ID works for development).
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# EAS project id (needed for Expo push tokens). Run `npx eas-cli init` to create one.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Default school id (single-school deployments can keep "default").
EXPO_PUBLIC_SCHOOL_ID=default

# ---- Backend (read by amplify/ at deploy time) ----
# Verified Amazon SES identity used by Cognito to send credential e-mails. Leave empty in sandbox
# to use Cognito's default sender (limited to 50 e-mails/day).
SES_FROM_EMAIL=
SES_FROM_NAME=School Office
SCHOOL_NAME=Our School

# ---- Secrets (NOT env vars) ----
# npx ampx sandbox secret set GOOGLE_ROUTES_API_KEY   # Routes API + Places API key, server-side only
