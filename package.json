{
  "name": "school-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "sandbox": "ampx sandbox",
    "sandbox:once": "ampx sandbox --once",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-owner": "tsx scripts/create-owner.ts",
    "create-bus": "tsx scripts/create-bus.ts",
    "smoke": "tsx scripts/smoke.ts",
    "wipe": "tsx scripts/wipe.ts",
    "sync-branding": "tsx scripts/sync-branding.ts",
    "repair-school-ids": "tsx scripts/repair-school-ids.ts",
    "export:web": "expo export --platform web",
    "doctor": "expo-doctor",
    "build": "expo export --platform web --output-dir dist"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/.amplify/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "dependencies": {
